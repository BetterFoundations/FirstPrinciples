# pnpm reads `publishConfig.provenance` from nowhere — its publish command only honours
# npm's classic `provenance` config key (CLI flag or .npmrc), never the package.json field.
# `changesets/cli` never passes `--provenance` itself, so without this, `pnpm changeset
# publish` silently drops provenance even with publishConfig.provenance: true set and
# id-token: write granted in release.yml. Root-level so every package's publish picks it up.
provenance=true

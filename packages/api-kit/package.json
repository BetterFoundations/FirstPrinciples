{
  "name": "@firstprinciples/api-kit",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Backend API response conventions: a typed success/error envelope, RFC 7807 problem-details formatting of core errors, schema-agnostic request validation, and Express/Fastify/Hono adapters.",
  "keywords": [
    "api",
    "rfc7807",
    "problem-details",
    "express",
    "fastify",
    "hono",
    "validation",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BetterFoundations/FirstPrinciples",
    "directory": "packages/api-kit"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/fastify.d.ts",
        "default": "./dist/fastify.js"
      },
      "require": {
        "types": "./dist/fastify.d.cts",
        "default": "./dist/fastify.cjs"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/hono.d.ts",
        "default": "./dist/hono.js"
      },
      "require": {
        "types": "./dist/hono.d.cts",
        "default": "./dist/hono.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@firstprinciples/core": "workspace:*"
  },
  "peerDependencies": {
    "express": ">=4.18.0",
    "fastify": ">=4.28.0",
    "hono": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@firstprinciples/eslint-config": "workspace:*",
    "@firstprinciples/tsconfig-base": "workspace:*",
    "@firstprinciples/vitest-config": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "express": "^5.2.1",
    "fastify": "^5.12.1",
    "hono": "^4.13.3",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}

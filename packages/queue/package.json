{
  "name": "@firstprinciples/queue",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Typed job queue conventions over BullMQ: end-to-end payload/result inference, retry presets, a real dead-letter queue, and metrics hooks.",
  "keywords": [
    "queue",
    "jobs",
    "bullmq",
    "dead-letter-queue",
    "retry",
    "backoff",
    "redis",
    "worker"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BetterFoundations/FirstPrinciples",
    "directory": "packages/queue"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@firstprinciples/core": "workspace:*"
  },
  "peerDependencies": {
    "bullmq": ">=6.0.0 <7"
  },
  "devDependencies": {
    "@firstprinciples/eslint-config": "workspace:*",
    "@firstprinciples/tsconfig-base": "workspace:*",
    "@firstprinciples/vitest-config": "workspace:*",
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "bullmq": "^6.3.9",
    "eslint": "^9.39.5",
    "ioredis": "^6.0.0",
    "testcontainers": "^12.1.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}

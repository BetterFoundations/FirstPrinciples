{
  "name": "@firstprinciples/core",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Typed error hierarchy, Result type, and branded primitives \u2014 the zero-dependency foundation every @firstprinciples package builds on.",
  "keywords": [
    "typescript",
    "result",
    "either",
    "error-handling",
    "branded-types",
    "nominal-typing",
    "typed-errors",
    "isomorphic"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BetterFoundations/FirstPrinciples",
    "directory": "packages/core"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@firstprinciples/eslint-config": "workspace:*",
    "@firstprinciples/tsconfig-base": "workspace:*",
    "@firstprinciples/vitest-config": "workspace:*",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}

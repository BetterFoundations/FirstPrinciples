{
  "name": "@firstprinciples/auth-utils",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Authentication primitives: argon2id password hashing with documented parameters, and JWT issue/verify with a mandatory algorithm allowlist.",
  "keywords": [
    "auth",
    "argon2",
    "argon2id",
    "password-hashing",
    "jwt",
    "jose",
    "algorithm-confusion",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BetterFoundations/FirstPrinciples",
    "directory": "packages/auth-utils"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./jwt": {
      "import": {
        "types": "./dist/jwt.d.ts",
        "default": "./dist/jwt.js"
      },
      "require": {
        "types": "./dist/jwt.d.cts",
        "default": "./dist/jwt.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@firstprinciples/core": "workspace:*",
    "jose": "^6.2.10"
  },
  "peerDependencies": {
    "argon2": ">=0.44.0 <1"
  },
  "devDependencies": {
    "@firstprinciples/eslint-config": "workspace:*",
    "@firstprinciples/tsconfig-base": "workspace:*",
    "@firstprinciples/vitest-config": "workspace:*",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "argon2": "^0.45.1",
    "eslint": "^10.9.1",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
